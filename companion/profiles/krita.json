{
  "version": 1,
  "id": "krita",
  "name": "Krita",
  "apps": ["krita.exe", "krita"],
  "default": false,
  "grid": { "cols": 1, "rows": 8 },
  "buttons": [
    { "id": "undo", "label": "Undo", "speak": "Undo", "kind": "tap",
      "col": 0, "row": 0, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "ctrl+z" } },
    { "id": "redo", "label": "Redo", "speak": "Redo", "kind": "tap",
      "col": 0, "row": 1, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "ctrl+shift+z" } },
    { "id": "brush", "label": "Brush", "speak": "Brush", "kind": "tap",
      "col": 0, "row": 2, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "b" } },
    { "id": "eraser", "label": "Eraser", "speak": "Eraser", "kind": "toggle",
      "col": 0, "row": 3, "colspan": 1, "rowspan": 1,
      "action": { "type": "eraser_toggle" } },
    { "id": "pan", "label": "Pan", "speak": "Pan", "kind": "hold",
      "col": 0, "row": 4, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "space" } },
    { "id": "zoom-in", "label": "Zoom in", "speak": "Zoom in", "kind": "tap",
      "col": 0, "row": 5, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "ctrl+equal" } },
    { "id": "zoom-out", "label": "Zoom out", "speak": "Zoom out", "kind": "tap",
      "col": 0, "row": 6, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "ctrl+minus" } },
    { "id": "save", "label": "Save", "speak": "Save", "kind": "tap",
      "col": 0, "row": 7, "colspan": 1, "rowspan": 1,
      "action": { "type": "key", "keys": "ctrl+s" } }
  ]
}
