<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon (API 26+; minSdk is 29 so this always applies).
     Foreground: the color logo on transparency; background: app near-black;
     monochrome: wallpaper-tinted Material You layer (API 33+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_logo_bg" />
    <foreground android:drawable="@drawable/ic_logo_fg" />
    <monochrome android:drawable="@drawable/ic_logo_mono" />
</adaptive-icon>
